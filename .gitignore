# ---- Python 隔离环境与字节码（每个队友本地各自生成，不要提交）----
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 用户上传的财报与本批材料的抽取结果 ----
# 每人的材料都放在自己机器上，绝不进入版本库。
# 目录结构：data/uploads/<run_id>/，含 PDF 原件、抽取文本、重建索引与分析结果。
data/uploads/

# ---- 全部运行产物（报告 / 指标宽表 / 轨迹）----
# 由 python run.py analyze 生成，可用同一批上传材料重复产出，因此不入库。
output/

# ---- 本地语料（仅开发与集成测试用，不含在交付物中）----
data/

# ---- 本机私有配置（密钥等敏感信息，绝不入库）----
config.local.yaml

# ---- 编辑器与操作系统杂项 ----
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ---- 分发包产物（历史遗留，本项目改为 GitHub 下载后本地运行）----
dist/
